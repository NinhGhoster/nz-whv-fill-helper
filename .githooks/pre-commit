#!/bin/sh
# Reject personal data before it reaches GitHub.
set -eu

fail() {
  echo "pre-commit: $*" >&2
  exit 1
}

staged=$(git diff --cached --name-only --diff-filter=ACMR)

for f in $staged; do
  case "$f" in
    lightning-autofill-*.csv)
      if [ "$f" != "lightning-autofill.example.csv" ]; then
        fail "$f looks like a private export; commit only lightning-autofill.example.csv"
      fi
      ;;
    extension/rules.json|rules-report.md)
      fail "$f is generated from a private export and must stay out of git"
      ;;
    extension/rules.js)
      if git show ":$f" | grep -q 'Generated by tools/build-rules.py'; then
        fail "extension/rules.js contains generated rules; commit the placeholder instead"
      fi
      ;;
  esac
done
